SAPLOGON_PATH=C:\Path\To\SAP\SAPgui\saplogon.exe
SAP_USER=YOUR_SAP_USER
SAP_CLIENT_S4DCLNT100=100
SAP_CONNECTION_S4DCLNT100=DEV SYSTEM
SAP_PASSWORD_S4DCLNT100=YOUR_PASSWORD
SAP_CLIENT_S4QCLNT100=100
SAP_CONNECTION_S4QCLNT100=QAD SYSTEM
SAP_PASSWORD_S4QCLNT100=YOUR_PASSWORD

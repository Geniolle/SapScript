TAXAS_CAMBIAIS_AUTHORITY_URL=https://login.microsoftonline.com
TAXAS_CAMBIAIS_GRAPH_SCOPE=https://graph.microsoft.com/.default
TAXAS_CAMBIAIS_MAX_MESSAGES=200
TAXAS_CAMBIAIS_PAGE_SIZE=50
TAXAS_CAMBIAIS_SKIP_INLINE_ATTACHMENTS=false
TAXAS_CAMBIAIS_ONLY_UNREAD=false


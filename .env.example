# Copy this file to .env and fill in local values.
# Never place real passwords, tokens, private keys, or client secrets here.

# Jira
JIRA_DADOS_COMP_HASH=
JIRA_DADOS_HASH=rest/api/3
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_API_TOKEN=
JIRA_SYNC_PROJECTS=SAP, IZ
JIRA_SYNC_JQL=project in (SAP, IZ) AND created >= -1825d AND status NOT IN ("Done", "Closed", "Concluído", "Fechado", "Fechada", "Cancelled") ORDER BY priority DESC, created ASC
JIRA_DOWNLOAD_DIR=C:/Jira
JIRA_DOWNLOAD_DIR_CONTAINER=/data/jira
JIRA_DOWNLOAD_DIR_WINDOWS=C:/Jira

# Jira automatic processing
JIRA_AUTO_TRIGGER_PROJECTS=SAP, IZ
JIRA_AUTO_TRIGGER_SUPPLIERS=
JIRA_AUTO_TRIGGER_ASSIGNEES=
AUTO_TRIGGER_ENABLED=false
AUTO_TRIGGER_INTERVAL_SECONDS=300
AUTO_TRIGGER_AMBIENTE=PRD
AUTO_TRIGGER_CATEGORY_MAP=
AUTO_TRIGGER_PROCESSO=
AUTO_TRIGGER_SUBPROCESSO=

# SAP GUI
SAP_USER=
SAP_LANGUAGE=PT
SAPLOGON_PATH=
SAP_CLIENT=
SAP_LOGIN_ON_MAIN=true
SAP_LOGIN_RUN=false
SAP_WINDOW_MODE=show
SAP_WINDOW_MINIMIZE=false
SAP_STMS_REMOTE_LOGIN_MODE=false
SAP_STMS_STATUSBAR_TIMEOUT=30
SAP_PESQUISAR_REQUEST_PATH=

# SAP GUI targets used by this repository
SAP_CONNECTION_S4DCLNT100=
SAP_CLIENT_S4DCLNT100=100
SAP_PASSWORD_S4DCLNT100=
SAP_CONNECTION_S4QCLNT100=
SAP_CLIENT_S4QCLNT100=100
SAP_PASSWORD_S4QCLNT100=
SAP_CONNECTION_S4PCLNT100=
SAP_CLIENT_S4PCLNT100=100
SAP_PASSWORD_S4PCLNT100=

# SAP RFC read-only connection
SAP_PASSWD=
SAP_ASHOST=
SAP_SYSNR=
SAP_LANG=PT
SAP_BUKRS=

# SAP RFC - PRD
SAP_PRD_USER=
SAP_PRD_PASSWD=
SAP_PRD_ASHOST=
SAP_PRD_SYSNR=
SAP_PRD_CLIENT=
SAP_PRD_LANG=PT

# SAP RFC - DEV (necessário apenas para a criação individual de função PFCG via RFC)
SAP_DEV_USER=
SAP_DEV_PASSWD=
SAP_DEV_ASHOST=
SAP_DEV_SYSNR=
SAP_DEV_CLIENT=
SAP_DEV_LANG=PT

# Workflow
WORKFLOW_ENABLED=true
WORKFLOW_STEP_CONFIRM=false
WORKFLOW_AMBIENTE=QAD
WORKFLOW_SAP_KEY=S4DCLNT100
WORKFLOW_SAP_SYSTEM=
WORKFLOW_SAP_CLIENT=
WORKFLOW_CAPTURE_VALIDATION_SCREEN=false
WORKFLOW_DOC_ENABLED=false
WORKFLOW_DOC_OUTPUT_DIR=
WORKFLOW_CONFIG_PATH=
WORKFLOW_STATE_PATH=
WORKFLOW_PYTHON_EXEC=

# Web API and Windows worker
API_BASE_URL=http://localhost:8010
WORKER_TOKEN=
WORKER_NAME=
POLL_SECONDS=60
RUN_ONCE=true
DATA_DIR=
SAP_SCRIPT_PROJECT_DIR=
SAP_COCKPIT_MODULE=sap_script_web_cockpit_v2.sap_cockpit_web_ready
UPLOADS_DIR=
UPLOADS_WINDOWS_DIR=

# Google Sheets
GOOGLE_CREDENTIALS_JSON=
SPREADSHEET_ID=
SHEET_NAME=DADOS
RESPONSAVEL_ALVO=
SUPPLIER_ALVO=
ESTADO_ALVO=

# AI integrations
GEMINI_API_KEY=

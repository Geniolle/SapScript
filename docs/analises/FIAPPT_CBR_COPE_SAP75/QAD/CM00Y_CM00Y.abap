  METHOD READ_ACC_FROM_FSV.

    DATA: LT_I011Z TYPE TABLE OF RF011Z,
          LS_I011Z LIKE LINE OF LT_I011Z,
          LS_ACCOUNT TYPE LINE OF FIAPPT_T_ACC_RANGE.

    CALL FUNCTION 'FI_IMPORT_BALANCE_SHEET_POS'
      EXPORTING
        VERSION           = GV_FSV
      TABLES
        I011Z             = LT_I011Z
*       X011P             =
*       X011S             =
*       X011V             =
*       X011F             =
      EXCEPTIONS
        NEW_BALANCE_SHEET = 1
        OTHERS            = 2.
    IF SY-SUBRC <> 0.
      RAISE NO_FSV_DATA.
    ENDIF.

    LOOP AT LT_I011Z INTO LS_I011Z.
      CLEAR LS_ACCOUNT.
      LS_ACCOUNT-SIGN = 'I'.
      LS_ACCOUNT-OPTION = 'BT'.
      IF LS_I011Z-ERGSO = 'EXT'.
        LS_ACCOUNT-LOW = LS_I011Z-VONKT.
        LS_ACCOUNT-HIGH = LS_I011Z-BILKT.
        APPEND LS_ACCOUNT TO GT_EXT_ACC_RANGE.
      ELSEIF LS_I011Z-ERGSO = 'INT'.
        LS_ACCOUNT-LOW = LS_I011Z-VONKT.
        LS_ACCOUNT-HIGH = LS_I011Z-BILKT.
        APPEND LS_ACCOUNT TO GT_INT_ACC_RANGE.
      ELSEIF LS_I011Z-ERGSO = 'OTH'.
        LS_ACCOUNT-LOW = LS_I011Z-VONKT.
        LS_ACCOUNT-HIGH = LS_I011Z-BILKT.
        APPEND LS_ACCOUNT TO GT_OTH_ACC_RANGE.
      ELSEIF LS_I011Z-ERGSO = 'BAL'.
        LS_ACCOUNT-LOW = LS_I011Z-VONKT.
        LS_ACCOUNT-HIGH = LS_I011Z-BILKT.
        APPEND LS_ACCOUNT TO GT_BAL_ACC_RANGE.
      ENDIF.
    ENDLOOP.

    IF GT_INT_ACC_RANGE IS INITIAL AND GT_EXT_ACC_RANGE IS INITIAL.
      RAISE NO_INT_EXT_ACC.
    ENDIF.

  ENDMETHOD.
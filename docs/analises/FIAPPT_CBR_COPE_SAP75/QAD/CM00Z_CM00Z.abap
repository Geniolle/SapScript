  METHOD READ_FAGLFLEXT.

    DATA: LV_FIELDNAME TYPE FIELDNAME,
          LT_FIELDLIST TYPE TTFIELDNAME,
          LT_FAGLFLEXT TYPE TABLE OF FAGLFLEXT,
          LT_FAGLFLEXT_TMP TYPE TABLE OF FAGLFLEXT,
          LS_FAGLFLEXT TYPE FAGLFLEXT,
          LT_GROUPLIST TYPE TTFIELDNAME,
          LT_GLT0 TYPE FAGL_T_GLT0,
          LS_GLT0 LIKE LINE OF LT_GLT0,
          LT_ACC_RANGE TYPE FIAPPT_T_ACC_RANGE,
          LV_LEDGER TYPE RLDNR.

    LV_LEDGER = IV_LEDGER.

    DATA: LV_CURSOR TYPE CURSOR,
          LV_PACKAGE_SIZE TYPE I VALUE 10000.

    LT_ACC_RANGE[] = IT_ACC_RANGE[].

    OPEN CURSOR LV_CURSOR FOR
    SELECT * FROM FAGLFLEXT         ##DB_FEATURE_MODE[TABLE_LEN_MAX1]
             WHERE RLDNR  = LV_LEDGER
             AND   RRCTY  = '0'
             AND   RVERS  = '001'
             AND   RBUKRS = GV_BUKRS
             AND   RYEAR  = GV_YEAR
             AND   RACCT  IN LT_ACC_RANGE[]
             AND   RPMAX  = '016'.
    DO.
      CLEAR  LT_FAGLFLEXT_TMP.
      FETCH NEXT CURSOR LV_CURSOR INTO CORRESPONDING FIELDS OF TABLE
      LT_FAGLFLEXT_TMP PACKAGE SIZE LV_PACKAGE_SIZE.
      IF SY-SUBRC NE 0.
        EXIT.
      ENDIF.
      APPEND LINES OF  LT_FAGLFLEXT_TMP TO LT_FAGLFLEXT.
    ENDDO.
    CLOSE CURSOR LV_CURSOR.

    IF LT_FAGLFLEXT IS NOT INITIAL.
      LOOP AT LT_FAGLFLEXT INTO LS_FAGLFLEXT.
        MOVE-CORRESPONDING LS_FAGLFLEXT TO LS_GLT0.
        LS_GLT0-BUKRS = GV_BUKRS.
        APPEND LS_GLT0 TO LT_GLT0.
      ENDLOOP.
    ENDIF.

    ET_GLT0[] = LT_GLT0[].

  ENDMETHOD.
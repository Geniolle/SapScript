* DEV_125 - Atrulizad Cengtro de Lucro no BP caso exista

* { WILL - 16/02/2022
  ZCL_BC_BREAK=>M_CHECK_BREAK_POINT( ZCL_BC_BREAK=>M_GET_CURRENT_BREAK_AREA( ) ).
* } WILL - 16/02/2022

  LOOP AT CS_CUST_EXTERN-SALES_DATA-SALES ASSIGNING FIELD-SYMBOL(<FS_SALES>)." INTO ls_sales_out.
    SELECT SINGLE PRCTR
      FROM ZCO_PRCTR_BP_T
      INTO <FS_SALES>-DATA-ZZPRCTR
      WHERE VKORG EQ <FS_SALES>-DATA_KEY-VKORG
        AND VTWEG EQ <FS_SALES>-DATA_KEY-VTWEG
        AND SPART EQ <FS_SALES>-DATA_KEY-SPART.
  ENDLOOP.
ENDENHANCEMENT.
  METHOD GET_VEND_CUS_BALANCES.

    DATA: LS_FIAPPTD_BALANCE TYPE FIAPPTD_BALANCE.

    CALL METHOD INIT_FIAPPTD_BAL_STR
      EXPORTING
        IT_DATE_RANGE      = IT_DATE_RANGE
      CHANGING
        ES_FIAPPTD_BALANCE = LS_FIAPPTD_BALANCE.

    LS_FIAPPTD_BALANCE-BANK_ID = ' '. "blank for vend-customer balances.
    LS_FIAPPTD_BALANCE-PAIS_CONTA = ' '. "blank for vend-customer balances.

    CALL METHOD GET_VEND_BALANCES
      EXPORTING
        IT_LFA1            = IT_LFA1
        IS_FIAPPTD_BALANCE = LS_FIAPPTD_BALANCE
        IT_VEND_SPLGL      = IT_VEND_SPLGL
        IT_VEND            = IT_VEND
      CHANGING
        ET_FIAPPTD_BALANCE = ET_FIAPPTD_BALANCE
        ET_XML_ITEMS       = ET_XML_ITEMS.

    CALL METHOD GET_CUST_BALANCES
      EXPORTING
        IT_KNA1            = IT_KNA1
        IS_FIAPPTD_BALANCE = LS_FIAPPTD_BALANCE
        IT_CUST_SPLGL      = IT_CUST_SPLGL
        IT_CUST            = IT_CUST
      CHANGING
        ET_FIAPPTD_BALANCE = ET_FIAPPTD_BALANCE
        ET_XML_ITEMS       = ET_XML_ITEMS.

  ENDMETHOD.
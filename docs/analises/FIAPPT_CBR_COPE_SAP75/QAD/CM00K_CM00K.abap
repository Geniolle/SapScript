  METHOD GET_PAID_DOC_FROM_BSEG.

    DATA: LT_PAYMENT_DOCS TYPE FIAPPT_T_TRANS_CBR.
    DATA: LT_VEN_PAID_ITEMS TYPE FIAPPT_T_TRANS_CBR,
          LT_VEN_PAID_ITEMS_TMP LIKE LT_VEN_PAID_ITEMS,
          LT_CUS_PAID_ITEMS TYPE FIAPPT_T_TRANS_CBR,
          LT_CUS_PAID_ITEMS_TMP LIKE LT_CUS_PAID_ITEMS,
          LT_GL_PAID_ITEMS TYPE FIAPPT_T_TRANS_CBR,
          LT_GL_PAID_TMP TYPE FIAPPT_T_TRANS_CBR.

    TYPES: BEGIN OF TY_BSAS,
     BUKRS TYPE BUKRS,
     GJAHR TYPE GJAHR,
     BELNR TYPE BELNR_D,
     BUZEI TYPE BUZEI,
    END OF TY_BSAS.

    DATA: LT_BSAS TYPE TABLE OF TY_BSAS,
          LT_BSAS_TMP LIKE LT_BSAS.

    DATA: LV_CURSOR TYPE CURSOR,
          LV_PACKAGE_SIZE TYPE I VALUE 10000.

    DATA: LT_PAYMENT_DOCS_GL LIKE IT_PAYMENT_DOCS_GL.

    IF IT_PAYMENT_DOCS_VEN IS NOT INITIAL.

            SELECT BUKRS BELNR GJAHR BUZEI AUGDT AUGBL WAERS BSCHL
              SHKZG DMBTR WRBTR SGTXT HKONT LIFNR ZFBDT ZTERM ZBD1T
              ZBD2T ZBD1P ZBD2P WSKTO QBSHB HBKID LZBKZ LANDL STCEG XRAGL
              HKTID XCPDD BVTYP PYCUR PYAMT
              FROM BSAK INTO CORRESPONDING FIELDS OF TABLE LT_VEN_PAID_ITEMS
              FOR ALL ENTRIES IN IT_PAYMENT_DOCS_VEN WHERE
                LIFNR EQ IT_PAYMENT_DOCS_VEN-LIFNR AND
                BUKRS EQ IT_PAYMENT_DOCS_VEN-BUKRS AND
                AUGDT IN IT_POSTING_DATE[]  AND
                AUGBL EQ IT_PAYMENT_DOCS_VEN-BELNR AND
                BELNR NE IT_PAYMENT_DOCS_VEN-BELNR AND
                BSTAT  = ' '.

      IF LT_VEN_PAID_ITEMS[] IS NOT INITIAL.
        APPEND LINES OF LT_VEN_PAID_ITEMS TO ET_PAID_ITEMS.
      ENDIF.
    ENDIF.

    IF IT_PAYMENT_DOCS_CUS IS NOT INITIAL.

            SELECT BUKRS BELNR GJAHR BUZEI AUGDT AUGBL WAERS BSCHL
              SHKZG DMBTR WRBTR SGTXT HKONT KUNNR ZFBDT ZTERM ZBD1T
              ZBD2T ZBD1P ZBD2P WSKTO HBKID LZBKZ LANDL STCEG XRAGL
              HKTID XCPDD BVTYP PYCUR PYAMT
              FROM BSAD INTO CORRESPONDING FIELDS OF TABLE LT_CUS_PAID_ITEMS
              FOR ALL ENTRIES IN IT_PAYMENT_DOCS_CUS WHERE
                KUNNR EQ IT_PAYMENT_DOCS_CUS-KUNNR AND
                BUKRS EQ IT_PAYMENT_DOCS_CUS-BUKRS AND
                AUGDT IN IT_POSTING_DATE[]     AND
                AUGBL EQ IT_PAYMENT_DOCS_CUS-BELNR AND
                BELNR NE IT_PAYMENT_DOCS_CUS-BELNR AND
                BSTAT  = ' ' .


      IF LT_CUS_PAID_ITEMS[] IS NOT INITIAL.
        APPEND LINES OF LT_CUS_PAID_ITEMS TO ET_PAID_ITEMS.
      ENDIF.

    ENDIF.

    IF IT_PAYMENT_DOCS_GL IS NOT INITIAL
      AND IV_SKIP_GL_ITEMS NE 'X'.

      LT_PAYMENT_DOCS_GL[] = IT_PAYMENT_DOCS_GL[].

      SORT LT_PAYMENT_DOCS_GL BY BUKRS BELNR GJAHR.
      DELETE ADJACENT DUPLICATES FROM LT_PAYMENT_DOCS_GL
      COMPARING BUKRS BELNR GJAHR.

            SELECT BUKRS GJAHR BELNR BUZEI
              FROM BSAS INTO CORRESPONDING FIELDS OF TABLE LT_BSAS
              FOR ALL ENTRIES IN IT_PAYMENT_DOCS_GL WHERE
                BUKRS EQ IT_PAYMENT_DOCS_GL-BUKRS AND
                HKONT EQ IT_PAYMENT_DOCS_GL-HKONT AND
                AUGDT IN IT_POSTING_DATE[] AND
                AUGBL EQ IT_PAYMENT_DOCS_GL-BELNR AND
                BELNR NE IT_PAYMENT_DOCS_GL-BELNR AND
                BSTAT  = ' ' .


      IF LT_BSAS IS NOT INITIAL.

         SELECT BUKRS BELNR GJAHR BUZEI AUGDT AUGBL KOART BSCHL
         SHKZG DMBTR WRBTR SGTXT HKONT LIFNR KUNNR WRBTR ZFBDT ZTERM ZBD1T
         ZBD2T  ZBD1P ZBD2P WSKTO QBSHB  HBKID LZBKZ LANDL STCEG XRAGL
         HKTID XCPDD BVTYP PYCUR PYAMT
         FROM BSEG INTO CORRESPONDING FIELDS OF TABLE LT_GL_PAID_ITEMS
                 FOR ALL ENTRIES IN LT_BSAS WHERE BUKRS EQ LT_BSAS-BUKRS AND
                                                  BELNR EQ LT_BSAS-BELNR AND
                                                  GJAHR EQ LT_BSAS-GJAHR AND
                                                  BUZEI EQ LT_BSAS-BUZEI.

        IF LT_GL_PAID_ITEMS[] IS NOT INITIAL.
          APPEND LINES OF LT_GL_PAID_ITEMS TO ET_PAID_ITEMS.
        ENDIF.

        IF ET_PAID_ITEMS[] IS INITIAL.
          RAISE NO_DATA.
        ENDIF.

      ENDIF.
    ENDIF.

  ENDMETHOD.
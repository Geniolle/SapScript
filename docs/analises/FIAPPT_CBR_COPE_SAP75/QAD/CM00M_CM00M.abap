METHOD GET_VAT_REG_NO.

  DATA: LV_TAX_NO TYPE STCEG,
        LV_LAND1 TYPE LAND1,
        LV_INTCA3 TYPE INTCA3.

  CLEAR :LV_TAX_NO, LV_INTCA3, LV_LAND1.

  LV_LAND1 = IV_STCEG+0(2).
  CALL METHOD ME->READ_T005
    EXPORTING
      IV_LAND   = LV_LAND1
    IMPORTING
      EV_INTCA3 = LV_INTCA3.

  IF LV_INTCA3 IS NOT INITIAL.
    CONCATENATE LV_INTCA3 '_' IV_STCEG+2(18) INTO
    LV_TAX_NO.
  ELSE.
    LV_TAX_NO = IV_STCEG.
  ENDIF.

  EV_STCEG = LV_TAX_NO.

ENDMETHOD.
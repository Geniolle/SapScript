  METHOD READ_T001.

    DATA: LS_T001 TYPE T001.
    CLEAR:  EV_COMP_TAX_CODE,  EV_COMP_CURR.

    CALL FUNCTION 'T001_READ'
      EXPORTING
        BUKRS    = GV_BUKRS
      IMPORTING
        STRUCT   = LS_T001
      EXCEPTIONS
        NO_ENTRY = 1
        OTHERS   = 2.

    IF SY-SUBRC <> 0.
      RAISE NO_ENTRY.
    ELSE.
      EV_COMP_TAX_CODE = LS_T001-STCEG.
      EV_COMP_CURR = LS_T001-WAERS.
    ENDIF.

  ENDMETHOD.
  METHOD SET_POSTING_DATE.

    DATA: LV_FIRST_DAY TYPE BUDAT,
          LV_LAST_DAY TYPE BUDAT,
          LS_POSTING_DATE TYPE FIAPPT_S_DATE_RANGE,
          LV_FISCAL_YEAR TYPE BAPI0002_4-FISCAL_YEAR,
          LV_FIS_PERIOD TYPE BAPI0002_4-FISCAL_PERIOD.

    LV_FIRST_DAY(4) = GV_YEAR.
    LV_FIRST_DAY+4(2) = GV_PERIOD.
    LV_FIRST_DAY+6(2) = '01'.
* Find the fiscal year and period for the company code and assign
* it to the global variables
    CALL FUNCTION 'BAPI_COMPANYCODE_GET_PERIOD'
      EXPORTING
        COMPANYCODEID = GV_BUKRS
        POSTING_DATE  = LV_FIRST_DAY
      IMPORTING
        FISCAL_YEAR   = LV_FISCAL_YEAR
        FISCAL_PERIOD = LV_FIS_PERIOD.

      GV_YEAR = LV_FISCAL_YEAR.
      GV_PERIOD = LV_FIS_PERIOD.

    CALL FUNCTION 'SLS_MISC_GET_LAST_DAY_OF_MONTH'
      EXPORTING
        DAY_IN            = LV_FIRST_DAY
      IMPORTING
        LAST_DAY_OF_MONTH = LV_LAST_DAY.

    IF SY-DATUM LE LV_LAST_DAY AND SY-DATUM GE LV_FIRST_DAY.
      LV_LAST_DAY = SY-DATUM.
    ENDIF.

    LS_POSTING_DATE-SIGN = 'I'.
    LS_POSTING_DATE-OPTION = 'BT'.
    LS_POSTING_DATE-LOW = LV_FIRST_DAY.
    LS_POSTING_DATE-HIGH = LV_LAST_DAY.
    APPEND LS_POSTING_DATE TO ET_POSTING_DATE.

  ENDMETHOD.
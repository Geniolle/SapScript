*&---------------------------------------------------------------------*
*&  Include           RFFOPT_CBR_SLSCR
*&---------------------------------------------------------------------*

SELECTION-SCREEN:

BEGIN OF BLOCK OTHERSEL WITH FRAME TITLE TEXT-001.
PARAMETER: P_BUKRS TYPE BUKRS OBLIGATORY,
           P_YEAR TYPE KALJAHR OBLIGATORY,          "calendar year
           P_PERIOD TYPE KMONA_FI OBLIGATORY,       "calendar month
           P_FSV TYPE T011T-VERSN OBLIGATORY,
           P_RUN_ID TYPE FIAPPT_RUN_ID OBLIGATORY.
SELECT-OPTIONS: P_BELNR FOR BKPF-BELNR.
SELECT-OPTIONS: P_BLART FOR BKPF-BLART.
SELECTION-SCREEN: END OF BLOCK OTHERSEL.

SELECTION-SCREEN: BEGIN OF BLOCK B2 WITH FRAME TITLE TEXT-014.

PARAMETER: P_GL TYPE FAGL_RLDNR DEFAULT '0L'.
SELECT-OPTIONS: P_GL_V FOR BSEG-UMSKZ.
SELECT-OPTIONS: P_GL_C FOR BSEG-UMSKZ.
SELECT-OPTIONS: P_VEND FOR BSEG-LIFNR.
SELECT-OPTIONS: P_CUST FOR BSEG-KUNNR.

SELECTION-SCREEN: END OF BLOCK B2.

SELECTION-SCREEN: BEGIN OF BLOCK B3 WITH FRAME TITLE TEXT-015.

PARAMETER P_GL_PAY TYPE FIAPPT_GL_PAY AS CHECKBOX.
PARAMETER P_AUTO TYPE FIAPPT_AUTO_PAY AS CHECKBOX.

SELECTION-SCREEN: END OF BLOCK B3.

SELECTION-SCREEN: BEGIN OF BLOCK FILE_CREATION WITH FRAME TITLE TEXT-002.

PARAMETER: P_TEST TYPE C AS CHECKBOX DEFAULT 'X',
           P_PC TYPE C RADIOBUTTON GROUP GP1 USER-COMMAND UC DEFAULT 'X' MODIF ID OPO,
           P_FILE1 TYPE RLGRAP-FILENAME MODIF ID PC,
           P_APPL TYPE C RADIOBUTTON GROUP GP1 MODIF ID OPO,   "on premise only
           P_FILE2 TYPE LOCALFILE MODIF ID AP.

SELECTION-SCREEN: END OF BLOCK FILE_CREATION.

SELECTION-SCREEN:
    SKIP,
    PUSHBUTTON /1(35) MNT_SCB USER-COMMAND MNT_SCB MODIF ID ICO. "Assign SCB Indicator

AT SELECTION-SCREEN OUTPUT.

  IF NOT GV_IS_S4H_CLOUD IS INITIAL.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 = 'AP' OR SCREEN-GROUP1 = 'OPO'.
        SCREEN-ACTIVE = 0.

        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.

    CLEAR: P_APPL,
           P_FILE2.
  ELSE.
    LOOP AT SCREEN.

      IF P_PC IS NOT INITIAL.
        IF SCREEN-GROUP1 = 'AP'.
          SCREEN-ACTIVE = 0.
        ENDIF.
    ENDIF.

      IF P_APPL IS NOT INITIAL.
        IF SCREEN-GROUP1 = 'PC'.
          SCREEN-ACTIVE = 0.
        ENDIF.
      ENDIF.

      IF SCREEN-GROUP1 = 'ICO'.
        SCREEN-ACTIVE = 0.
      ENDIF.

      MODIFY SCREEN.

    ENDLOOP.
  ENDIF.
*----------------------------------------------------------------------*
* F4-Help for file local location                                      *
*----------------------------------------------------------------------*
AT SELECTION-SCREEN ON VALUE-REQUEST FOR P_FILE1.
  PERFORM LOC_BROWSER_F4 CHANGING P_FILE1.

AT SELECTION-SCREEN.

  IF NOT GV_IS_S4H_CLOUD IS INITIAL AND SSCRFIELDS-UCOMM EQ 'MNT_SCB'. "Cloud pushbutton
    AUTHORITY-CHECK OBJECT 'S_TCODE'
         ID 'TCD' FIELD 'FIAPPT_BAL'.
    IF SY-SUBRC = 0. "Call the t-code for assigning SCB Indicator
      CALL TRANSACTION 'FIAPPT_BAL' AND SKIP FIRST SCREEN.
    ELSE.
      MESSAGE W107(IDFIPT).
    ENDIF.
  ENDIF.

 IF GV_IS_S4H_CLOUD IS INITIAL.
*- in cloud do not check for linkage between Company Code and FSV
*** BEGIN OF ILM Enablement ***
  DATA: LT_FSV TYPE FIAPPT_T_FSV.
  IF P_BUKRS IS NOT INITIAL.
    CALL METHOD CL_FIAPPT_CBR=>GET_FSV
      EXPORTING
        IV_BUKRS = P_BUKRS
      IMPORTING
        ET_FIAPPTC_FSV = LT_FSV.
    READ TABLE LT_FSV WITH TABLE KEY MANDT = SY-MANDT
                                     BUKRS = P_BUKRS
                                     VERSN = P_FSV
                      TRANSPORTING NO FIELDS.
    IF SY-SUBRC NE 0.
      MESSAGE E413(FIAPPT_CBR) WITH P_FSV P_BUKRS.
    ENDIF.
  ENDIF.
*** END OF ILM Enablement ***
  ENDIF.
  IF P_TEST NE 'X'  AND P_PC NE 'X' AND P_APPL NE 'X'.
    MESSAGE E005(FIAPPT_CBR).
  ELSEIF P_PC EQ 'X' AND P_FILE1 IS INITIAL AND P_TEST IS INITIAL.
    SET CURSOR FIELD 'P_FILE1'.
    MESSAGE E006(FIAPPT_CBR).
  ELSEIF P_PC EQ 'X' AND P_FILE1 IS NOT INITIAL.
    PERFORM CHECK_LOCAL_PATH CHANGING P_FILE1.
  ELSEIF P_APPL EQ 'X' AND P_FILE2 IS INITIAL AND P_TEST IS INITIAL.
    SET CURSOR FIELD 'P_FILE2'.
    MESSAGE E006(FIAPPT_CBR).
  ENDIF.

  DATA: LV_FIRST_DAY     TYPE BUDAT,
        LV_FISCAL_YEAR   TYPE GJAHR,
        LV_FISCAL_PERIOD TYPE MONAT.

  LV_FIRST_DAY(4)   = P_YEAR.
  LV_FIRST_DAY+4(2) = P_PERIOD.
  LV_FIRST_DAY+6(2) = '01'.

  CALL FUNCTION 'BAPI_COMPANYCODE_GET_PERIOD'
    EXPORTING
      COMPANYCODEID = P_BUKRS
      POSTING_DATE  = LV_FIRST_DAY
    IMPORTING
      FISCAL_YEAR   = LV_FISCAL_YEAR
      FISCAL_PERIOD = LV_FISCAL_PERIOD.

  IF P_RUN_ID IS NOT INITIAL.     "Validation for RUNID
    SELECT SINGLE * FROM FIAPPTD_RUNID
      WHERE BUKRS = P_BUKRS AND REPORTING_YEAR = LV_FISCAL_YEAR
      AND PERIOD = LV_FISCAL_PERIOD AND RUN_ID = P_RUN_ID.
    IF SY-SUBRC EQ 0.
      SET CURSOR FIELD 'P_RUN_ID'.
      CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        TEXT_QUESTION = TEXT-018
        TEXT_BUTTON_1 = TEXT-016
        TEXT_BUTTON_2 = TEXT-017
      IMPORTING
        ANSWER        = GV_ANS.

    IF GV_ANS EQ '1'.

    SELECT * FROM FIAPPTD_TRANS INTO CORRESPONDING FIELDS OF TABLE GT_FIAPPTD_TRANS
                  WHERE BUKRS = P_BUKRS   AND
                            PAY_DOC_YEAR = LV_FISCAL_YEAR AND
                            PERIOD = LV_FISCAL_PERIOD AND
                        RUN_ID = P_RUN_ID.
    SELECT * FROM FIAPPTD_BALANCE INTO CORRESPONDING FIELDS OF TABLE GT_FIAPPTD_BALANCE
                  WHERE BUKRS = P_BUKRS   AND
                            REPORTING_YEAR = LV_FISCAL_YEAR AND
                            PERIOD = LV_FISCAL_PERIOD AND
                        RUN_ID = P_RUN_ID.
**** BEGIN OF ILM Enablement ***
    IF GT_FIAPPTD_TRANS IS INITIAL AND
       GT_FIAPPTD_BALANCE IS INITIAL.

        CALL METHOD CL_FI_CBR_PT_READ_AO=>READ_ARCHIVED_DATA
          EXPORTING
            IV_BUKRS                       = P_BUKRS
              IV_YEAR                        = LV_FISCAL_YEAR
              IV_PERIOD                      = LV_FISCAL_PERIOD
            IV_RUN_ID                      = P_RUN_ID
*             IV_RUN_DATE                    =
          IMPORTING
            ET_FIAPPTD_RUNID               = GT_AO_FIAPPTD_RUNID
            ET_FIAPPTD_BALANCE             = GT_AO_FIAPPTD_BALANCE
            ET_FIAPPTD_TRANS               = GT_AO_FIAPPTD_TRANS
          EXCEPTIONS
            NO_ACTIVE_INFOSTRUCT_FOUND     = 1
            MISSING_ENTRIES_FOR_AS_FAST_AC = 2
              OTHERS                         = 3.
        IF SY-SUBRC EQ 0 AND GT_AO_FIAPPTD_RUNID IS NOT INITIAL.

* Search for data in archive tables
          CLEAR: GT_FIAPPTD_TRANS,
                 GT_FIAPPTD_BALANCE.
          LOOP AT GT_AO_FIAPPTD_BALANCE INTO GS_AO_FIAPPTD_BALANCE
            WHERE BUKRS = P_BUKRS         AND
                    REPORTING_YEAR = LV_FISCAL_YEAR AND
                    PERIOD = LV_FISCAL_PERIOD       AND
                  RUN_ID = P_RUN_ID.
            APPEND GS_AO_FIAPPTD_BALANCE TO GT_FIAPPTD_BALANCE.
          ENDLOOP.

          LOOP AT GT_AO_FIAPPTD_TRANS INTO GS_AO_FIAPPTD_TRANS
            WHERE BUKRS = P_BUKRS   AND
                    DOC_YEAR = LV_FISCAL_YEAR AND
                    PERIOD = LV_FISCAL_PERIOD AND
                  RUN_ID = P_RUN_ID.
            APPEND GS_AO_FIAPPTD_TRANS TO GT_FIAPPTD_TRANS.
          ENDLOOP.
        ELSE.
          IF SY-SUBRC EQ 1.
            MESSAGE W409. "Active infostructure not found
          ELSE.
              MESSAGE W410. "Data not found in archive
          ENDIF.
          LEAVE SCREEN.
        ENDIF.

    ENDIF.
* Filter data for blocked vendors/customers
    CLEAR GV_DATA_IS_FILTERED.
    CALL METHOD CL_FIAPPT_CBR=>FILTER_CBR_DATA
      EXPORTING
        IV_BUKRS            = P_BUKRS
      CHANGING
        EV_DATA_IS_FILTERED = GV_DATA_IS_FILTERED
        ET_FIAPPTD_TRANS    = GT_FIAPPTD_TRANS
        ET_FIAPPTD_BALANCE  = GT_FIAPPTD_BALANCE.

    IF GV_DATA_IS_FILTERED EQ ABAP_TRUE.
      MESSAGE W411.
    ENDIF.
**** END OF ILM Enablement ***

    PERFORM BUILD_FIELD_CATALOG.
    PERFORM BUILD_LAYOUT.
    PERFORM EVENTTAB_BUILD.
    PERFORM ALV_DISPLAY.

    LEAVE SCREEN.
    ELSEIF GV_ANS EQ '2' OR GV_ANS EQ 'A'.
    LEAVE SCREEN.
    ENDIF.
    ENDIF.
    GV_LENGTH = STRLEN( P_RUN_ID ).
    GV_LENGTH = GV_LENGTH - 1 .
    IF P_RUN_ID+GV_LENGTH(1) CA '0123456789'.
      SET CURSOR FIELD 'P_RUN_ID'.
      MESSAGE E017(FIAPPT_CBR).
    ENDIF.
  ENDIF.

  IF P_FSV IS NOT INITIAL.          "Validation for FSV
    SELECT SINGLE XERGS KTOPL FROM T011 INTO CORRESPONDING FIELDS OF GS_T011 WHERE VERSN = P_FSV.
    SELECT SINGLE * FROM T001 INTO GS_T001 WHERE BUKRS = P_BUKRS.
    IF GS_T011-KTOPL NE GS_T001-KTOPL.
      MESSAGE E012(FIAPPT_CBR) WITH P_FSV GS_T001-KTOPL.
    ENDIF.
  ENDIF.
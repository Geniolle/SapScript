  METHOD INITIALIZE_XML_HEADER.

    DATA: LS_XML_HEADER TYPE FIAPPT_S_CBR_XML_HEADER,
          LV_COMP_TAX_CODE TYPE STCEG.

    IF IV_TEST = 'X'.
      LS_XML_HEADER-FLAG_TEST = 'X'.
    ENDIF.

    LS_XML_HEADER-FINANCIAL_ID = ''.
    LS_XML_HEADER-GJAHR = GV_YEAR.
    LS_XML_HEADER-PERIOD = GV_PERIOD.

    CALL METHOD READ_T001
      IMPORTING
        EV_COMP_TAX_CODE = LV_COMP_TAX_CODE.

    LS_XML_HEADER-NPC = LV_COMP_TAX_CODE+2(9).

    ES_XML_HEADER = LS_XML_HEADER.

  ENDMETHOD.
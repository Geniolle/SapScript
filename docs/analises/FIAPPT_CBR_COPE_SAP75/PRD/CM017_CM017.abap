  METHOD FILTER_CVP.

    DATA: LS_BSEG_VC_CUS  LIKE LINE OF CT_BSEG_VC_CUS,
          LS_BSEG_VC_GL   LIKE LINE OF CT_BSEG_VC_GL,
          LS_BSEG_REM_ALL LIKE LINE OF CT_BSEG_REM_ALL,
          LS_BSEG_VC      LIKE LINE OF CT_BSEG_VC,
          LS_BSEG_GL      LIKE LINE OF CT_BSEG_GL,
          LS_BSEG_VC_VEN  LIKE LINE OF CT_BSEG_VC_VEN.

* Delete item for vendors and customers not in ranges
* CT_BSEG_VC_CUS
    DELETE CT_BSEG_VC_CUS WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_VC_CUS WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

* CT_BSEG_VC_GL
    DELETE CT_BSEG_VC_GL WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_VC_GL WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

* CT_BSEG_REM_ALL
    DELETE CT_BSEG_REM_ALL WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_REM_ALL WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

* CT_BSEG_VC
    DELETE CT_BSEG_VC WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_VC WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

* CT_BSEG_GL
    DELETE CT_BSEG_GL WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_GL WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

* CT_BSEG_VC_VEN
    DELETE CT_BSEG_VC_VEN WHERE KUNNR IS NOT INITIAL AND KUNNR NOT IN RT_KNA1.
    DELETE CT_BSEG_VC_VEN WHERE LIFNR IS NOT INITIAL AND LIFNR NOT IN RT_LFA1.

  ENDMETHOD.
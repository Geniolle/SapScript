  METHOD CONVERT_AMOUNT_FOR_FILE.

    DATA: POWER(2) TYPE P.
    DATA: LS_TCURX TYPE TCURX.
    CLEAR: POWER.

    SELECT SINGLE * FROM TCURX INTO LS_TCURX WHERE CURRKEY = IV_WAERS.
    IF SY-SUBRC EQ 0.
      POWER = 2 - LS_TCURX-CURRDEC.
    ENDIF.

    EV_AMOUNT = IV_AMOUNT * ( 10 ** POWER ).

  ENDMETHOD.
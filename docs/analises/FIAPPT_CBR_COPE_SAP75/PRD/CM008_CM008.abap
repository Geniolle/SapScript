  METHOD CREATE_XML_FILE.
    DATA: XSLT_ERROR TYPE REF TO CX_XSLT_RUNTIME_ERROR.
    TRY.
        CALL TRANSFORMATION FIAPPT_CBR_XML_TRANS
        SOURCE CBRHEADER = IS_HEADER
               CBRITEM   = IT_ITEMS
        RESULT XML EV_XML_XSTRING.
      CATCH CX_XSLT_RUNTIME_ERROR INTO XSLT_ERROR.
        RAISE NO_XML.
    ENDTRY.
  ENDMETHOD.
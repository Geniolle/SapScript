  METHOD GET_VEND_BALANCES.

    DATA: LT_LFA1 LIKE IT_LFA1,
          LT_LFA1_ALL LIKE IT_LFA1,
          LS_LFA1 TYPE LFA1,
          LS_FIAPPTD_BALANCE LIKE IS_FIAPPTD_BALANCE,
          IT_BAL_DIFF_CURRENCY TYPE TABLE OF BAPI3008_3.

    DATA: LV_LAND TYPE LAND1,
          LV_LAND_ISO TYPE INTCA3,
          LV_NPC2 TYPE FIAPPT_NPC2,
          OBJ_CBR_HANDLE TYPE REF TO BADI_RFFOPT_CBR.
    DATA: LS_RETURN TYPE BAPIRETURN.

    DATA: LS_XML_ITEMS TYPE FIAPPT_S_CBR_XML_ITEMS.
    DATA: LV_REG_EXISTS TYPE FLAG,
          LV_REG_CHANGED TYPE FLAG,
          LV_ORIGIN_RUNID TYPE FIAPPT_RUN_ID.

    DATA: LT_BAL_SCB TYPE TABLE OF FIAPPTD_BAL_SCB,
          LS_BAL_SCB TYPE FIAPPTD_BAL_SCB,
          LS_BAL_SCB_H TYPE FIAPPTD_BAL_SCB,
          LS_BAL_SCB_S TYPE FIAPPTD_BAL_SCB,
          LS_TCURC TYPE TCURC,
          LV_STCEG TYPE STCEG.

    DATA IT_VEND_DATA TYPE TABLE OF RFPOSXEXT.
    DATA: IT_LIFNR_SEL TYPE FIAPPT_T_LIFNR,
          LS_LIFNR_SEL TYPE LINE OF FIAPPT_T_LIFNR.

    DATA: LT_BUKRS_RANGE TYPE RANGE OF BUKRS,
          LS_BUKRS_RANGE LIKE LINE OF LT_BUKRS_RANGE.

    TYPES: BEGIN OF IT_BALANCE ,
      KONTO TYPE KONTO,
             CONCUR TYPE CHAR8,
           WAERS TYPE WAER_DOC,  " doc curr
      UMSKZ TYPE UMSKZ,     "Spl g/l indicator
      WRSHB TYPE WRSHB_X8,  "doc amt
      DMSHB TYPE DMSHB_X8,  "amt in loc curr
      HWAER TYPE HWAER,     "local curr
           BELNR TYPE BELNR_D,
           GJAHR TYPE GJAHR,
           BUKRS TYPE BUKRS,
           LAND1 TYPE LAND1,
           STCEG TYPE STCEG,
           NPC2  TYPE FIAPPT_NPC2,
           END OF  IT_BALANCE.

    DATA: IT_BAL_DIFF_CURR TYPE TABLE OF IT_BALANCE,
          LS_BAL_DIFF_CURR LIKE LINE OF IT_BAL_DIFF_CURR,
          LS_BAL TYPE RFPOSXEXT,
          LS_BAL2 LIKE LINE OF IT_BAL_DIFF_CURR.

    TYPES: BEGIN OF IT_COUNT,
           BUKRS TYPE BUKRS,
           BELNR TYPE BELNR_D,
           BUZEI TYPE BUZEI,
           GJAHR TYPE GJAHR,
           LAND1 TYPE LAND1,
           END OF IT_COUNT.


    DATA: IT_BAL_COUNT TYPE TABLE OF IT_COUNT,
          LS_BAL_COUNT LIKE LINE OF IT_BAL_COUNT.

    DATA: LV_RUNID_SEQ TYPE FIAPPT_RUN_ID.
    DATA: LV_BSEC TYPE BSEC.
    DATA: LV_INDEX TYPE SY-TABIX.
    DATA: LV_CBR_FLAG TYPE C.

    CONSTANTS CV_CURR TYPE WAERS VALUE 'EUR'.
**Instantiation of Badi..
    GET BADI OBJ_CBR_HANDLE.

    LS_FIAPPTD_BALANCE = IS_FIAPPTD_BALANCE.
    LT_LFA1_ALL[] = IT_LFA1[].
    LT_LFA1[] = IT_LFA1.

    SORT LT_LFA1 BY LIFNR.

* Fetch all the SCB codes for the vendor accounts
* from the table fiapptd_bal_scb
    SELECT * FROM FIAPPTD_BAL_SCB INTO TABLE LT_BAL_SCB
      WHERE BUKRS = GV_BUKRS AND KOART = 'K'.
*Reading the default SCB values
    READ TABLE LT_BAL_SCB INTO LS_BAL_SCB_H WITH KEY
                BUKRS = GV_BUKRS
                ACCOUNT = '*'
                KOART = 'K'
                SHKZG = 'H'.

    READ TABLE LT_BAL_SCB INTO LS_BAL_SCB_S WITH KEY
                BUKRS = GV_BUKRS
                ACCOUNT = '*'
                KOART = 'K'
                SHKZG = 'S'.

    LOOP AT LT_LFA1 INTO LS_LFA1 .
      LS_LIFNR_SEL-SIGN = 'I'.
      LS_LIFNR_SEL-OPTION = 'EQ'.
      IF IT_VEND[] IS NOT INITIAL
      AND LS_LFA1-LIFNR NOT IN IT_VEND[].
        CONTINUE.
      ELSE.
        LS_LIFNR_SEL-LOW = LS_LFA1-LIFNR.
        APPEND LS_LIFNR_SEL TO IT_LIFNR_SEL .
      ENDIF.
    ENDLOOP.

*   build input data for selection screen
    LS_BUKRS_RANGE-SIGN   = 'I'.
    LS_BUKRS_RANGE-OPTION = 'EQ'.
    LS_BUKRS_RANGE-LOW    = GV_BUKRS.
    APPEND LS_BUKRS_RANGE TO LT_BUKRS_RANGE.

IF IT_LIFNR_SEL IS NOT INITIAL.

    LV_CBR_FLAG = 'X'.
    EXPORT VARIABLE FROM LV_CBR_FLAG TO MEMORY ID 'PT_CBR'.

    SUBMIT RFITEMAP
    WITH KD_LIFNR IN IT_LIFNR_SEL[]
    WITH KD_BUKRS IN LT_BUKRS_RANGE[]
    WITH X_OPSEL EQ 'X'
    WITH PA_STIDA EQ LS_FIAPPTD_BALANCE-REFERENCE_DATE
    WITH X_NORM EQ 'X'
    WITH X_SHBV EQ 'X'
    EXPORTING LIST TO MEMORY AND RETURN.

    IMPORT STRUCTURE TO IT_VEND_DATA FROM MEMORY ID 'PT_CBR_VEND'.
* Vendors Open items selected for the balance
    CALL BADI OBJ_CBR_HANDLE->MODIFY_VEND_CUST_ITEMS_BAL
      CHANGING
        CT_VEND_DATA = IT_VEND_DATA.

    FREE MEMORY ID 'PT_CBR_VEND'.
    FREE MEMORY ID 'PT_CBR'.

    LS_FIAPPTD_BALANCE-KOART = 'K'.

    IF IT_VEND_DATA IS NOT INITIAL.
      CLEAR: IT_BAL_DIFF_CURR, LS_BAL, LS_BAL2.
      LOOP AT IT_VEND_DATA INTO LS_BAL.
        IF LS_BAL-UMSKZ IS INITIAL.
          IF LS_BAL-WAERS EQ 'PTE' OR LS_BAL-WAERS EQ 'SDR'
            OR LS_BAL-WAERS EQ 'ESP' OR LS_BAL-WAERS EQ 'ESP.' OR LS_BAL-WAERS EQ 'FRF'.
            MOVE-CORRESPONDING LS_BAL TO LS_BAL2.
            LS_BAL2-WAERS = LS_BAL-HWAER.
            LS_BAL2-WRSHB = LS_BAL-DMSHB.
            LS_BAL2-BELNR = LS_BAL-BELNR.
            APPEND LS_BAL2 TO IT_BAL_DIFF_CURR.
          ELSE.
            MOVE-CORRESPONDING LS_BAL TO LS_BAL2.
            APPEND LS_BAL2 TO IT_BAL_DIFF_CURR.
          ENDIF.
        ELSEIF LS_BAL-UMSKZ IN IT_VEND_SPLGL[].
          IF LS_BAL-WAERS EQ 'PTE' OR LS_BAL-WAERS EQ 'SDR'
             OR LS_BAL-WAERS EQ 'ESP' OR LS_BAL-WAERS EQ 'ESP.' OR LS_BAL-WAERS EQ 'FRF'.
            MOVE-CORRESPONDING LS_BAL TO LS_BAL2.
            LS_BAL2-WAERS = LS_BAL-HWAER.
            LS_BAL2-WRSHB = LS_BAL-DMSHB.
            LS_BAL2-BELNR = LS_BAL-BELNR.
            APPEND LS_BAL2 TO IT_BAL_DIFF_CURR.
          ELSE.
            MOVE-CORRESPONDING LS_BAL TO LS_BAL2.
            APPEND LS_BAL2 TO IT_BAL_DIFF_CURR.
          ENDIF.
        ENDIF.
      ENDLOOP.

*    "This will atleast free the memory used as it has tooo many fields in it....
*      CLEAR: it_vend_data.
    IF IT_BAL_DIFF_CURR IS NOT INITIAL.
      SELECT BUKRS BELNR BUZEI GJAHR LAND1 FROM BSEC
              INTO CORRESPONDING FIELDS OF TABLE IT_BAL_COUNT
              FOR ALL ENTRIES IN IT_BAL_DIFF_CURR
                  WHERE BUKRS EQ IT_BAL_DIFF_CURR-BUKRS AND
                        BELNR EQ IT_BAL_DIFF_CURR-BELNR AND
                        GJAHR EQ IT_BAL_DIFF_CURR-GJAHR.
    ENDIF.

      LOOP AT IT_BAL_DIFF_CURR INTO LS_BAL_DIFF_CURR.
          CLEAR: LS_BAL_COUNT, LS_LFA1.
          READ TABLE IT_BAL_COUNT INTO LS_BAL_COUNT
              WITH KEY BELNR = LS_BAL_DIFF_CURR-BELNR.

              IF LS_BAL_DIFF_CURR-BELNR = LS_BAL_COUNT-BELNR.
            LS_BAL_DIFF_CURR-LAND1 = LS_BAL_COUNT-LAND1. "One-Time Account
            LS_LFA1-LIFNR = LS_BAL_DIFF_CURR-KONTO.
          ELSE.
        READ TABLE IT_LFA1 INTO LS_LFA1 WITH KEY
            LIFNR = LS_BAL_DIFF_CURR-KONTO
             BINARY SEARCH.

      CALL METHOD ME->GET_VAT_REG_NO
        EXPORTING
          IV_STCEG = LS_LFA1-STCEG
        IMPORTING
            EV_STCEG = LV_STCEG.

        IF LS_BAL_DIFF_CURR-LAND1 IS INITIAL.
          LS_BAL_DIFF_CURR-LAND1 = LS_LFA1-LAND1.
            ENDIF.

          ENDIF.

          CALL METHOD READ_T005
           EXPORTING
             IV_LAND   = LS_BAL_DIFF_CURR-LAND1
           IMPORTING
            EV_INTCA3 = LV_LAND_ISO.

      TRY.
          CALL BADI OBJ_CBR_HANDLE->GET_BALANCES
            EXPORTING
              LFA1            = LS_LFA1
              FIAPPTD_BALANCE = IS_FIAPPTD_BALANCE
            CHANGING
                NPC2            = LV_NPC2
                CV_STCEG        = LV_STCEG.
        CATCH CX_SY_DYN_CALL_ILLEGAL_METHOD.
      ENDTRY.

         LS_BAL_DIFF_CURR-LAND1 = LV_LAND_ISO.
         LS_BAL_DIFF_CURR-STCEG = LV_STCEG.
         LS_BAL_DIFF_CURR-NPC2 = LV_NPC2.

          LS_BAL_DIFF_CURR-CONCUR(5)   = LS_BAL_DIFF_CURR-WAERS.
          LS_BAL_DIFF_CURR-CONCUR+5(3) = LS_BAL_DIFF_CURR-LAND1.
         MODIFY IT_BAL_DIFF_CURR FROM LS_BAL_DIFF_CURR.
         CLEAR LS_BAL_DIFF_CURR.
         CLEAR LS_BAL_COUNT.
          CLEAR :LS_LFA1,LV_STCEG.

    ENDLOOP.

    DELETE IT_BAL_DIFF_CURR WHERE LAND1 = 'PRT'.
    SORT IT_BAL_DIFF_CURR BY KONTO CONCUR.

    LOOP AT IT_BAL_DIFF_CURR INTO LS_BAL_DIFF_CURR.

        LS_FIAPPTD_BALANCE-ACCOUNT = LS_BAL_DIFF_CURR-KONTO.
        LS_FIAPPTD_BALANCE-NPC2 = LS_BAL_DIFF_CURR-NPC2.
        LS_FIAPPTD_BALANCE-STCEG = LS_BAL_DIFF_CURR-STCEG.
        LS_FIAPPTD_BALANCE-PAIS_CONTRAPARTE = LS_BAL_DIFF_CURR-LAND1.

        CLEAR LS_TCURC.
        "Vendor balances in each of the transaction currencies.
        CLEAR LS_FIAPPTD_BALANCE-SCB_IND.

        AT END OF CONCUR.
          SUM.
          LS_FIAPPTD_BALANCE-WRBTR = LS_BAL_DIFF_CURR-WRSHB.
            LS_FIAPPTD_BALANCE-WAERS = LS_BAL_DIFF_CURR-CONCUR+0(5).

* Fill the SCB Codes for the vendor based on
* the sign of the amount
            IF LS_FIAPPTD_BALANCE-WRBTR < 0.
              LS_FIAPPTD_BALANCE-WRBTR = LS_FIAPPTD_BALANCE-WRBTR * -1.
              READ TABLE LT_BAL_SCB INTO LS_BAL_SCB WITH KEY
                BUKRS = GV_BUKRS
              ACCOUNT = LS_BAL_DIFF_CURR-KONTO
                KOART = 'K'
                SHKZG = 'H'.
              IF SY-SUBRC = 0.
                LS_FIAPPTD_BALANCE-SCB_IND = LS_BAL_SCB-SCB_IND.
              ELSE.
                LS_FIAPPTD_BALANCE-SCB_IND = LS_BAL_SCB_H-SCB_IND.
              ENDIF.
            ELSE.
              READ TABLE LT_BAL_SCB INTO LS_BAL_SCB WITH KEY
               BUKRS = GV_BUKRS
             ACCOUNT = LS_BAL_DIFF_CURR-KONTO
               KOART = 'K'
               SHKZG = 'S'.
              IF SY-SUBRC = 0.
                LS_FIAPPTD_BALANCE-SCB_IND = LS_BAL_SCB-SCB_IND.
              ELSE.
                LS_FIAPPTD_BALANCE-SCB_IND = LS_BAL_SCB_S-SCB_IND.
              ENDIF.
            ENDIF.

            IF GV_PERIOD_1ST_RUN EQ 'X'.
* Add the next sequence to the run id
              GV_RUNID_SEQ = GV_RUNID_SEQ + 1.
              LV_RUNID_SEQ = GV_RUNID_SEQ.
              SHIFT LV_RUNID_SEQ LEFT DELETING LEADING SPACE.
              CONCATENATE GV_RUNID LV_RUNID_SEQ INTO LS_FIAPPTD_BALANCE-ORIGIN_RUN_ID.

            ELSE.
              CLEAR: LV_REG_EXISTS,  LV_REG_CHANGED , LV_ORIGIN_RUNID.
              CALL METHOD ME->CHECK_OLD_BAL_REGISTERS
                EXPORTING
                  IS_FIAPPTD_BALANCE = LS_FIAPPTD_BALANCE
                IMPORTING
                  EV_REG_EXISTS      = LV_REG_EXISTS
                  EV_REG_CHANGED     = LV_REG_CHANGED
                  EV_ORIGIN_RUNID    = LV_ORIGIN_RUNID.

              IF LV_REG_EXISTS EQ 'X' AND LV_REG_CHANGED = 'X'.
                LS_FIAPPTD_BALANCE-REGISTER_ID = 'M'.
                LS_FIAPPTD_BALANCE-ORIGIN_RUN_ID = LV_ORIGIN_RUNID.
              ELSEIF LV_REG_EXISTS EQ ''.
                LS_FIAPPTD_BALANCE-REGISTER_ID = 'C'.
* Add the next sequence to the run id
                GV_RUNID_SEQ = GV_RUNID_SEQ + 1.
                LV_RUNID_SEQ = GV_RUNID_SEQ.
                SHIFT LV_RUNID_SEQ LEFT DELETING LEADING SPACE.
                CONCATENATE GV_RUNID LV_RUNID_SEQ INTO LS_FIAPPTD_BALANCE-ORIGIN_RUN_ID.
              ELSEIF LV_REG_EXISTS EQ 'X'.
                CONTINUE.
              ENDIF.
            ENDIF.
*  Zero balance in new register then
*  do not report the balance
            IF LS_FIAPPTD_BALANCE-REGISTER_ID = 'C'
              AND LS_FIAPPTD_BALANCE-WRBTR IS INITIAL.
              CONTINUE.
            ENDIF.

            MOVE-CORRESPONDING LS_FIAPPTD_BALANCE TO LS_XML_ITEMS.

            IF LS_FIAPPTD_BALANCE-WAERS NE CV_CURR.
            CALL METHOD CONVERT_AMOUNT_FOR_FILE
                EXPORTING
                  IV_WAERS  = LS_FIAPPTD_BALANCE-WAERS
                  IV_AMOUNT = LS_XML_ITEMS-WRBTR
                IMPORTING
                EV_AMOUNT = LS_XML_ITEMS-WRBTR.
            ENDIF.

            READ TABLE GT_TCURC INTO LS_TCURC WITH KEY
            WAERS = LS_XML_ITEMS-WAERS BINARY SEARCH.
            IF SY-SUBRC = 0 AND LS_TCURC-ISOCD IS NOT INITIAL.
            LS_XML_ITEMS-ISOCD = LS_TCURC-ISOCD.
            LS_FIAPPTD_BALANCE-ISOCD = LS_TCURC-ISOCD.
            ENDIF.
            APPEND LS_XML_ITEMS TO ET_XML_ITEMS.
            APPEND LS_FIAPPTD_BALANCE TO ET_FIAPPTD_BALANCE.

          ENDAT.
        ENDLOOP.
      ENDIF.
ENDIF.

  ENDMETHOD.
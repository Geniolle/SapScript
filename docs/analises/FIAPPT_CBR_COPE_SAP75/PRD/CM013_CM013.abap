  METHOD UPDATE_DB_TABLES.

    DATA: LS_FIAPPTD_RUNID TYPE FIAPPTD_RUNID.

    IF IT_FIAPPTD_TRANS IS NOT INITIAL OR IT_FIAPPTD_BALANCE IS NOT INITIAL.

      CALL METHOD READ_T001
        IMPORTING
          EV_COMP_TAX_CODE = LS_FIAPPTD_RUNID-NPC.

      LS_FIAPPTD_RUNID-BUKRS = GV_BUKRS. LS_FIAPPTD_RUNID-REPORTING_YEAR = GV_YEAR.
      LS_FIAPPTD_RUNID-PERIOD = GV_PERIOD. LS_FIAPPTD_RUNID-RUN_DATE = SYST-DATLO.
      LS_FIAPPTD_RUNID-RUN_ID = GV_RUNID. LS_FIAPPTD_RUNID-RUN_TIME = SYST-TIMLO.
      LS_FIAPPTD_RUNID-FINANCIAL_ID = ''.

      MODIFY FIAPPTD_RUNID FROM LS_FIAPPTD_RUNID.
      MODIFY FIAPPTD_TRANS FROM TABLE IT_FIAPPTD_TRANS.
      MODIFY FIAPPTD_BALANCE FROM TABLE IT_FIAPPTD_BALANCE.

    ENDIF.

  ENDMETHOD.
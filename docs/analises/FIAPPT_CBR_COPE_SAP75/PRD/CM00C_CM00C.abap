  METHOD GET_BANK_DATA.

    DATA: LS_T012 TYPE T012.
    CLEAR: EV_BANKL, EV_BANKS.

    SELECT SINGLE BANKS BANKL FROM T012 INTO
      CORRESPONDING FIELDS OF LS_T012 WHERE BUKRS = GV_BUKRS
      AND HBKID = IV_HBKID.

    IF SY-SUBRC = 0.
      EV_BANKL = LS_T012-BANKL.
*      SHIFT ev_bankl LEFT DELETING LEADING '0'.
      CALL METHOD READ_T005
      EXPORTING
        IV_LAND = LS_T012-BANKS
      IMPORTING
        EV_INTCA3 = EV_BANKS.
    ENDIF.

  ENDMETHOD.
  METHOD GET_ACCOUNTS.

    DATA : IT_ACC_RANGE TYPE  FIAPPT_T_ACC_RANGE.

    REFRESH : ET_SKB1.

    APPEND LINES OF GT_EXT_ACC_RANGE TO IT_ACC_RANGE.
    APPEND LINES OF GT_INT_ACC_RANGE TO IT_ACC_RANGE.
    APPEND LINES OF GT_OTH_ACC_RANGE TO IT_ACC_RANGE.
    APPEND LINES OF GT_BAL_ACC_RANGE TO IT_ACC_RANGE.

    IF IT_ACC_RANGE[] IS NOT INITIAL.
      SELECT * FROM SKB1 INTO TABLE ET_SKB1 WHERE
       BUKRS EQ GV_BUKRS AND
       SAKNR IN IT_ACC_RANGE[]. "#EC CI_GENBUFF
    ENDIF .

  ENDMETHOD.
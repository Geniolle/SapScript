FUNCTION ZFI_CHANGE_PAISCONTA.
*"----------------------------------------------------------------------
*"*"Interface local:
*"  CHANGING
*"     REFERENCE(CT_FIAPPTD_TRANS) TYPE  FIAPPT_T_TRANS
*"     REFERENCE(CT_XML_ITEMS) TYPE  FIAPPT_T_CBR_XML_ITEMS
*"----------------------------------------------------------------------

DATA: LS_AUX TYPE STRING,
      LS_HKONT TYPE STRING.

 LOOP AT CT_FIAPPTD_TRANS ASSIGNING FIELD-SYMBOL(<FS_FIAPPTD_TRANS>) WHERE BANK_ACC_TYPE = 'E' AND PAIS_CONTA = '' .

    SELECT SINGLE HKONT
      INTO @LS_HKONT
      FROM BSEG
      WHERE BSEG~BUKRS = @<FS_FIAPPTD_TRANS>-BUKRS
      AND BSEG~BELNR = @<FS_FIAPPTD_TRANS>-PAY_DOC
      AND BSEG~GJAHR = @<FS_FIAPPTD_TRANS>-DOC_YEAR
      AND BSEG~HKONT LIKE '0012%'.

    CLEAR LS_AUX.
    IF SY-SUBRC = 0.
      LS_AUX =  |{ SUBSTRING( VAL = LS_HKONT OFF = 0 LEN = STRLEN( LS_HKONT ) - 1 ) }0| .

      SELECT T005~INTCA3
        INTO @<FS_FIAPPTD_TRANS>-PAIS_CONTA
        FROM T012K
        INNER JOIN T012 ON T012~BUKRS = T012K~BUKRS AND T012~HBKID = T012K~HBKID
        INNER JOIN T005 ON T005~LAND1 = T012~BANKS
        WHERE T012K~HKONT = @LS_AUX.
        ENDSELECT.
    ENDIF.
  ENDLOOP.

   LOOP AT CT_XML_ITEMS ASSIGNING FIELD-SYMBOL(<FS_XML_ITEMS>) WHERE BANK_ACC_TYPE = 'E' AND PAIS_CONTA = ''.

        SPLIT <FS_XML_ITEMS>-OBSERVATIONS AT '/' INTO: DATA(STR1) DATA(STR2) DATA(STR3),
                          TABLE DATA(ITAB).

        SELECT SINGLE HKONT
          INTO @LS_HKONT
          FROM BSEG
          WHERE BSEG~BUKRS = @STR3
          AND BSEG~BELNR = @STR1
          AND BSEG~GJAHR = @STR2
          AND BSEG~HKONT LIKE '0012%'.
        CLEAR LS_AUX.

        IF SY-SUBRC = 0.
          LS_AUX =  |{ SUBSTRING( VAL = LS_HKONT OFF = 0 LEN = STRLEN( LS_HKONT ) - 1 ) }0| .

          SELECT T005~INTCA3
            INTO @<FS_XML_ITEMS>-PAIS_CONTA
            FROM T012K
            INNER JOIN T012 ON T012~BUKRS = T012K~BUKRS AND T012~HBKID = T012K~HBKID
            INNER JOIN T005 ON T005~LAND1 = T012~BANKS
            WHERE T012K~HKONT = @LS_AUX.
            ENDSELECT.
        ENDIF.

ENDLOOP.


ENDFUNCTION.
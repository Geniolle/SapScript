ENHANCEMENT 1  .

CONSTANTS: LC_TCODE TYPE TCODE VALUE 'BP',
           LC_FIELD TYPE BUS000TBFL-TBFLD VALUE 'GS_LFB1-ZWELS'.

DATA: LV_ZLSPR_A       TYPE BSEG-ZLSPR.

FIELD-SYMBOLS: <FS_LFB1> TYPE LFB1,
               <FS_TXT> TYPE TEXTL_008.

IF SY-TCODE = LC_TCODE.

  ASSIGN ('(SAPLCVI_FS_UI_VENDOR_CC)GS_LFB1') TO <FS_LFB1>.

  IF <FS_LFB1> IS ASSIGNED .

     IF <FS_LFB1>-ZWELS EQ 'L'.

      CALL METHOD ZCLCA_FIXEDVALS=>GET_CONS_VAL
      EXPORTING
        IV_BUKRS = SPACE
        IV_MODUL = ZTGCA_C_MOD_FIN
        IV_PROCE = 'BLOCK_VENDOR'
        IV_FNAME = 'PAYMENT_METHOD'
        IV_SEQUE = 0
      IMPORTING
        EV_CONST = LV_ZLSPR_A
      EXCEPTIONS
        NO_DATA  = 1
        OTHERS   = 2.

      IF LV_ZLSPR_A EQ <FS_LFB1>-ZWELS.

        SELECT SINGLE ZLSCH, REASON FROM ZFI_PM_INFO_T
            INTO ( @DATA(LV_ZLSCH), @DATA(LV_TXT) )
           WHERE BUKRS = @<FS_LFB1>-BUKRS
             AND ZLSCH = @<FS_LFB1>-ZWELS.

      IF SY-SUBRC EQ 0 AND LV_ZLSCH IS NOT INITIAL.
        <FS_LFB1>-ZAHLS = LV_ZLSPR_A.
        UNASSIGN <FS_TXT>.
        ASSIGN ('(SAPLCVI_FS_UI_VENDOR_CC)V_PAYMENTBLOCK_TXT') TO <FS_TXT>.
        IF <FS_TXT> IS ASSIGNED..
          <FS_TXT> = LV_TXT.
        ENDIF.
      ENDIF.

        SELECT SINGLE ZAHLS FROM LFB1
          INTO @DATA(LV_ZAHLS)
         WHERE LIFNR = @<FS_LFB1>-LIFNR
           AND BUKRS = @<FS_LFB1>-BUKRS.

        IF SY-SUBRC EQ 0 AND LV_ZAHLS IS NOT INITIAL.
          <FS_LFB1>-ZAHLS = LV_ZAHLS.

          SELECT SINGLE TEXTL FROM T008T INTO LV_TXT
            WHERE SPRAS = SY-LANGU
              AND ZAHLS = LV_ZAHLS.

          UNASSIGN <FS_TXT>.
          ASSIGN ('(SAPLCVI_FS_UI_VENDOR_CC)V_PAYMENTBLOCK_TXT') TO <FS_TXT>.
          IF <FS_TXT> IS ASSIGNED..
            <FS_TXT> = LV_TXT.
          ENDIF.

        ENDIF.
      ENDIF.
     ENDIF.

  ENDIF.

ENDIF.

ENDENHANCEMENT.
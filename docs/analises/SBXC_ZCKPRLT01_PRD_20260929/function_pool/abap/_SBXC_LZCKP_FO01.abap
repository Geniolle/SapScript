*{   INSERT         DEVK939019                                        1
*&---------------------------------------------------------------------*
*&      Module  POPULATE_SCREEN  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE populate_screen OUTPUT.

*   Set which line of table is a top of displayed table control
  IF sy-stepl = 1.

    sc_tc-lines = sc_tc-top_line + sy-loopc - 1.

  ENDIF.
ENDMODULE.
*}   INSERT

*{   INSERT         DEVK939019                                        2
*&---------------------------------------------------------------------*
*&      Module  SC_TC_CHANGE_TC_ATTR  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE sc_tc_change_tc_attr OUTPUT.
  DESCRIBE TABLE lt_ped LINES sc_tc-lines.
ENDMODULE.
*}   INSERT

